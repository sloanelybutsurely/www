---
import path from "node:path";
import PageLayout from "./Page.astro";
import NoteBreadcrumbs from "@/components/NoteBreadcrumbs.astro";
import "@/styles/notes.css";

const { note } = Astro.props;

const basename = path.basename(note.id);
const dirname = path.dirname(note.id);
const title = (() => {
  if (note.data.title) return note.data.title;
  if (basename === "index") {
    if (dirname === ".") return "notes";

    return dirname;
  }
  return basename;
})();
---

<PageLayout pageTitle={title} class="note">
  <h1>{title}</h1>
  <NoteBreadcrumbs note={note} />
  {
    note.data.draft && (
      <p>
        <strong>DRAFT:</strong> This note is a draft. It is likely incomplete
        and may contain errors.
      </p>
    )
  }
  <slot />
</PageLayout>

<style>
  h1:first-of-type {
    margin-bottom: var(--space-3xs);
  }
</style>
