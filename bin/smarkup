#!/usr/bin/env -S awk -f
BEGIN {
  print "<!doctype html>"
  print
}

{
  sub(":", "", $1);
  content = substr($0, length($1) + 2)
}
$1 == "link" { links[$2] = $3; last = ""; next }

$1 == "h1" {
  print "<title>" content "</title>"
  print "<h1>" content "</h1>"
}
$1 == "h2" { print "<h2>" content "</h2>" }
$1 == "h3" { print "<h3>" content "</h3>" }
$1 == "h4" { print "<h4>" content "</h4>" }
$1 == "h5" { print "<h5>" content "</h5>" }
$1 == "h6" { print "<h6>" content "</h6>" }

$1 == "p" { print "<p>" content "</p>" }


last && ($1 == "ul" || $1 == "ol") && $1 != last {
  print "<" $1 ">"
}

last && (last == "ul" || last == "ol") && $1 != last {
  print "</" $1 ">"
}

{ last = $1 }

END {
  if (last == "ul" || last == "ol") print "</" last ">"
}
